{
  "name": "@qbar/qbar",
  "version": "0.2.0",
  "description": "Density-aware ticks for anything laid out by a quantile function: distributions, ETAs, non-linear sliders.",
  "keywords": [
    "ticks",
    "axis",
    "quantile",
    "distribution",
    "uncertainty",
    "slider",
    "range-slider",
    "web-components",
    "data-visualization"
  ],
  "homepage": "https://khoda81.github.io/qbar/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khoda81/qbar.git"
  },
  "bugs": {
    "url": "https://github.com/khoda81/qbar/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "demo": "bun ./demo/index.html ./demo/playground.html",
    "demo:build": "rm -rf site && bun build ./demo/index.html ./demo/playground.html --outdir site --minify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc && bun test && bun run build && prettier --check .",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
