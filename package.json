{
  "name": "qbar",
  "version": "0.1.0",
  "description": "Density-aware ticks for anything laid out by a quantile function",
  "type": "module",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "demo": "bun ./demo/index.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc && bun test && bun run build && prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
