{
  "name": "qbar",
  "version": "0.1.0",
  "description": "A pixel-resolution quantile rasterizer",
  "type": "module",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun run build && node --test test/*.test.mjs",
    "demo": "bun ./demo/index.html",
    "demo:dist": "bun run build && bun ./demo/index.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.demo.json && bun run test && bun run format:check"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
